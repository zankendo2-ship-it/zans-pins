@@ -0,0 +1,30 @@
+"""Every order route is gated: the old (defective) print files are BLOCKED, the v2 files PASS, and no route can
+upload a print file before the gate has run. Run: python -m pytest -q etsy/print_qa/tests"""
+import os, re, sys
+HERE = os.path.dirname(os.path.abspath(__file__)); ETSY = os.path.dirname(os.path.dirname(HERE)); FIX = os.path.join(os.path.dirname(HERE), 'fixtures')
+sys.path.insert(0, ETSY)
+from print_gate import gate
+BAUBLE = dict(position='front', x=.5, y=.5, scale=1, angle=0, blueprint_id=1676, variant_id=115590)
+MUG = dict(position='front', x=.5, y=.5, scale=1, angle=0, blueprint_id=635, variant_id=72180)
+quiet = lambda *a: None
+
+def test_old_bauble_files_blocked():
+    for ref in ('own-loussiemoo', 'own-rexs-romance', 'own-zoo-olympios', '4234028141', '4235438251', '4243574200'):
+        p = os.path.join(ETSY, 'orders', f'{ref}.png')
+        assert not gate('bauble_harrier', p, p[:-4] + '.svg', BAUBLE, quiet), ref
+def test_old_mug_render_blocked(tmp_path):
+    from PIL import Image
+    p = tmp_path / 'old.png'; Image.new('RGB', (2475, 1155), (0, 132, 61)).save(p)  # 1x, no ICC, no master = the 2 Nov route
+    assert not gate('mug_harrier_11oz', str(p), None, MUG, quiet)
+def test_v2_files_pass():
+    assert gate('bauble_harrier', os.path.join(FIX, 'good_bauble.png'), os.path.join(FIX, 'good_bauble.svg'), BAUBLE, quiet)
+    assert gate('mug_harrier_11oz', os.path.join(FIX, 'good_mug.png'), os.path.join(FIX, 'good_mug.svg'), MUG, quiet)
+def test_wrong_placement_blocked():
+    assert not gate('bauble_harrier', os.path.join(FIX, 'good_bauble.png'), os.path.join(FIX, 'good_bauble.svg'), dict(BAUBLE, scale=1.2), quiet)
+def test_gate_error_blocks():
+    assert not gate('bauble_harrier', '/no/such/file.png', None, BAUBLE, quiet)
+def test_every_route_gates_before_upload():
+    for f in ('mug_orders.py', 'bauble_order.py', 'own_bauble_order.py', 'own_bauble_multi.py'):
+        s = open(os.path.join(ETSY, f)).read()
+        assert 'from print_gate import gate' in s, f
+        assert s.index('gate(') < s.index("'uploads/images.json'"), f
